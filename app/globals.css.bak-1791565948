@import "tailwindcss";
:root{--primary:#f59e0b;--primary-2:#ea580c;--success:#16a34a;--danger:#dc2626;--info:#3b82f6;--bg:#f5f7fa;--text:#0f172a;--muted:#64748b;--card:#fff;--line:#e2e8f0;--radius:20px;color-scheme:light}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,"Noto Sans Arabic",sans-serif}a{color:inherit;text-decoration:none}button,input,select,textarea{font:inherit}.container{width:min(1180px,calc(100% - 32px));margin-inline:auto}.glass{background:rgba(255,255,255,.82);backdrop-filter:blur(16px);border:1px solid rgba(226,232,240,.8)}.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 8px 28px rgba(15,23,42,.04)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;padding:11px 16px;font-weight:700;cursor:pointer;transition:transform .2s,box-shadow .2s}.btn:hover{transform:translateY(-1px)}.btn-primary{background:linear-gradient(135deg,var(--primary),var(--primary-2));color:#fff;box-shadow:0 8px 18px #f59e0b33}.btn-soft{background:#fff7ed;color:#9a3412;border:1px solid #fed7aa}.field{width:100%;border:1px solid #dbe2ea;background:#fff;border-radius:12px;padding:12px 14px;outline:none}.field:focus{border-color:var(--primary);box-shadow:0 0 0 3px #f59e0b22}.muted{color:var(--muted)}.section{padding:72px 0}.eyebrow{display:inline-flex;padding:7px 12px;border-radius:999px;background:#fff7ed;color:#9a3412;font-size:13px;font-weight:800}.stat-card{padding:20px;border-radius:18px;background:linear-gradient(140deg,#fff,#fffaf2);border:1px solid #f1e7d4}.pill{display:inline-flex;border-radius:999px;padding:5px 10px;font-size:12px;font-weight:700}.pill-green{background:#dcfce7;color:#166534}.pill-amber{background:#fef3c7;color:#92400e}.pill-red{background:#fee2e2;color:#991b1b}.sidebar-link{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:12px;color:#475569}.sidebar-link:hover,.sidebar-link.active{background:#fff7ed;color:#9a3412}.grid-products{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.product-image{aspect-ratio:1/1;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f8fafc,#fff7ed);overflow:hidden;border-radius:15px}.product-image img{width:100%;height:100%;object-fit:cover}.dark-mode{--bg:#0b1220;--text:#e5e7eb;--muted:#94a3b8;--card:#111b2d;--line:#243147;color-scheme:dark}.dark-mode .field{background:#111b2d;color:#e5e7eb;border-color:#334155}.dark-mode .glass{background:rgba(17,27,45,.86);border-color:#243147}.dark-mode .stat-card{background:#111b2d;border-color:#243147}.dark-mode .sidebar-link{color:#cbd5e1}.dark-mode .sidebar-link:hover,.dark-mode .sidebar-link.active{background:#3a2912;color:#fed7aa}@media(max-width:900px){.grid-products{grid-template-columns:repeat(2,minmax(0,1fr))}.section{padding:48px 0}}@media(max-width:520px){.container{width:calc(100% - 24px)}.grid-products{gap:10px}.card{border-radius:16px}.section{padding:38px 0}}
